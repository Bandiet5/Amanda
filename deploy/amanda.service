[Unit]
Description=Amanda se Kersfees gift exchange
After=network.target

[Service]
Type=simple
User=amanda
Group=amanda
WorkingDirectory=/opt/amanda
EnvironmentFile=/opt/amanda/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/amanda/.venv/bin/waitress-serve --listen=127.0.0.1:8080 --threads=8 --trusted-proxy=127.0.0.1 --trusted-proxy-headers="x-forwarded-for x-forwarded-proto x-forwarded-host" server.wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/amanda

[Install]
WantedBy=multi-user.target
