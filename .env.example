# Generate a private .env with scripts/configure.py; do not use this file as-is.
APP_ENV=production
SECRET_KEY=
PUBLIC_ORIGIN=https://gifts.your-company.co.za
# Absolute path on local persistent storage, outside the frontend/dist directories.
DATABASE_PATH=/var/lib/amanda/amanda.sqlite3
# Must be 0 in production; 1 is permitted only for local development.
ALLOW_INSECURE_HTTP=0
# Optional alternative to the interactive set-admin-password command:
# ADMIN_PASSWORD_HASH='scrypt:...'
